# Transport MCP : "stdio" (défaut, dev local / Claude Desktop), "http" ou "sse".
# HOST/PORT ne servent qu'aux transports HTTP. L'image Docker force déjà http:8080.
MCP_TRANSPORT=stdio
HOST=0.0.0.0
PORT=8080

# ⚠️ En conteneur, utiliser les URLs INTERNES du homelab (nom de conteneur sur le réseau
# Docker partagé, ex. http://sonarr:8989) — jamais les URLs Cloudflare/publiques.
SONARR_URL=http://localhost:8989
SONARR_API_KEY=your_sonarr_api_key_here

RADARR_URL=http://localhost:7878
RADARR_API_KEY=your_radarr_api_key_here

# Prowlarr (indexer manager) — Servarr API on /api/v1.
PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=your_prowlarr_api_key_here

# qBittorrent is accessed through "qui" (autobrr), NOT qBittorrent directly.
QUI_URL=https://qui.example.com
QUI_API_KEY=your_qui_api_key_here
# Optional: target instance by id or name. Leave empty to auto-select the only instance.
QUI_INSTANCE=

# Jellyfin (media server for curated collections / BoxSets). Endpoints at the server root
# (no /api prefix). Create the key from Dashboard > API Keys. Auth: MediaBrowser Token.
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=your_jellyfin_api_key_here
