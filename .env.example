SONARR_API_KEY=your_sonarr_api_key_here

RADARR_URL=http://localhost:7878
RADARR_API_KEY=your_radarr_api_key_here

# Prowlarr (indexer manager) — Servarr API on /api/v1.
PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=your_prowlarr_api_key_here

# qBittorrent is accessed through "qui" (autobrr), NOT qBittorrent directly.
QUI_URL=https://qui.example.com
QUI_API_KEY=your_qui_api_key_here
# Optional: target instance by id or name. Leave empty to auto-select the only instance.
QUI_INSTANCE=
